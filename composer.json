{
    "name": "gsebastiao/laravel-authz",
    "description": "Grupos e permissões (RBAC) para Laravel, simples de começar: cascata de prioridade, validade por data, multi-tenant, cache e auditoria opcionais.",
    "keywords": [
        "laravel",
        "rbac",
        "permissions",
        "roles",
        "acl",
        "authorization",
        "multi-tenant"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gerson Sebastião Cossa",
            "email": "gsebastiao@example.github.com",
            "homepage": "https://github.com/gsebastiao"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0|^5.0"
    },
    "suggest": {
        "gsebastiao/laravel-auditable": "Permite auditoria automática dos CRUDs deste pacote (config('authz.audit.enabled'))."
    },
    "autoload": {
        "psr-4": {
            "Gsebastiao\\LaravelAuthz\\": "src/"
        },
        "files": [
            "src/Concerns/AuditableModelSupport.php",
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gsebastiao\\LaravelAuthz\\Tests\\": "tests/",
            "Gsebastiao\\Auditable\\": "tests/Stubs/Gsebastiao/Auditable/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gsebastiao\\LaravelAuthz\\LaravelAuthzServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
